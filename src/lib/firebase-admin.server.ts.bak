import admin from 'firebase-admin';

if (!admin.apps.length) {
  admin.initializeApp({
    credential: admin.credential.cert({
      projectId: "lovable-a893f",
      // We don't have the private key, but for Cloudflare Workers we often use the Web SDK anyway.
      // However, the user is getting PERMISSION_DENIED on the server.
      // If we use firebase-admin, it bypasses security rules.
      // But we can't use firebase-admin easily without a service account key.
    })
  });
}

export const adminFirestore = admin.firestore();
export const adminDatabase = admin.database();
export const { collection, getDocs, doc, getDoc, setDoc, updateDoc, deleteDoc, query, where, orderBy, limit } = admin.firestore;
