rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is a whitelisted admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'admin@gmail.com' || 
         request.auth.token.email == 'gmail@gmail.com' || 
         request.auth.token.email == 'r12130549@gmail.com');
    }

    // Orders: Anyone can create, anyone can read single for tracking
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true; // Temporary allow for easier tracking lookup
      allow update, delete: if isAdmin();
    }

    // Extensions/Products: Public read, Admin write
    match /extensions/{extensionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings: Public read, Admin write
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: Public create (sign up), Admin manage
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
    
    // Default allow for read (to avoid dashboard breaks), but lock writes to admin
    match /{document=**} {
      allow read: if true; 
      allow write: if isAdmin();
    }
  }
}
